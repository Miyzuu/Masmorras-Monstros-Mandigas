; Engine configuration file.
; Edit this file through the Godot editor whenever possible.

config_version=5

[application]

config/name="Pindorama Fantástica — Protótipo"
config/version="V.0.1.0"
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=768
window/size/viewport_height=512
window/size/window_width_override=768
window/size/window_height_override=512
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0549, 0.0431, 0.0314, 1)
